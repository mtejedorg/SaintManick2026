; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Saint Manick"
config/description="2.5D Action-Roguelite Beat'em up"
config/version="0.1.0"
run/main_scene="res://levels/slice/vertical_slice.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

SignalBus="*res://_core/signal_bus.gd"
Conductor="*res://_core/conductor.gd"
SaveManager="*res://_core/persistence/save_manager.gd"
GameManager="*res://_core/game_manager.gd"
HitStop="*res://_core/juice/hit_stop.gd"
AudioManager="*res://_core/audio_manager.gd"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Saint Manick"

[filesystem]

import/blender/enabled=false

